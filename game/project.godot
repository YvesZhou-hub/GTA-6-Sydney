config_version=5

[application]
config/name="Harbourlife · 悉尼海港"
run/main_scene="res://bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"
config/version="0.2.2"

[autoload]
RuntimeDiagnostics="*res://scripts/runtime_diagnostics.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
rendering_device/driver.macos="metal"
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.49,0.68,0.79,1)

[physics]
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_linear_velocity=2200.0
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true
jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=true
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=9.81

[debug]
gdscript/warnings/treat_warnings_as_errors=false

[editor]
movie_writer/mjpeg_quality=0.55
movie_writer/fps=24

[shader_globals]
city_night_amount={
"type": "float",
"value": 0.0
}
